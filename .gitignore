__pycache__/
*.pyc
.pytest_cache/

# ASTRAN LP solver temp files (written to cwd during cellgen)
ILPmodel*
# Per-cell LP working directories used by astran_queue (parallel-safe cwd)
**/.lpwork/

# Vendored ASTRAN build artifacts (regenerated by tools/astran/build_astran.sh)
tools/astran/build/Release/
tools/astran/build/bin/
tools/astran/build/bin/Astran
tools/astran/build/bin/Astran.exe
tools/astran/build/bin/*.dll

# Local test run outputs
.pyTest/

# Customer installer build output (tools/package/* -> dist/)
dist/

# Local GUI screenshots and layout preview renders (not repo documentation)
.gui_shots/
layout_preview/

# tools/package build products (rebuilt by make_stage.py / make_installer.py)
tools/package/AutoCellLibX.exe
tools/package/launcher_res.o
outputs/width_proxy.json

# Sensitive case work — must never leave this machine (no commit, no push).
# The cmp42 compressor experiment lives here; keep it untracked on purpose.
flow/_cmp42_work/
# Convention for future sensitive cases: a top-level _private*/ directory
# anywhere is never tracked.  Put such work there instead of inventing a
# new unprotected path.
**/_private*/
# Belt and braces: any stray file named after the case stays local too.
*cmp42*
*CMP42*
